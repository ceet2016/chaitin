<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 雷池社区版控制台默认使用 9443 端口的自签名证书，因此放宽校验策略 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
